# Plantilla de variables de entorno. Copiar a .env y rellenar.
#   cp .env.example .env
#
# Cada variable de aquí está realmente leída por el código; la referencia
# apunta al archivo que la consume.

# ═══ OBLIGATORIAS ════════════════════════════════════════════════════════════

# ─── Base de datos ─── prisma.config.ts:12
# PostgreSQL en Docker en el VPS, NO expuesto a internet (bind 127.0.0.1).
# Desde local hay que abrir un túnel SSH en otra terminal y dejarlo vivo:
#   ssh -N -L 5433:127.0.0.1:5432 TU_USUARIO@agotech.cloud
# Si la password lleva caracteres especiales, URL-encodearlos:
#   } %7D    > %3E    @ %40    / %2F    : %3A    # %23    ? %3F
DATABASE_URL="postgresql://coach_app:PASSWORD@127.0.0.1:5433/coach_financiero?schema=public"
#
# Según dónde corra la app, cambia solo el host:puerto
#   local + túnel SSH ........ 127.0.0.1:5433
#   en el VPS (node/pm2) ..... 127.0.0.1:5432
#   contenedor en shared_net . shared_postgres:5432

# ─── Administrador inicial ─── prisma/seed.mts:32,33,34
# Los lee `npx prisma db seed` para crear el único usuario que nace sin
# invitación; desde él se invita a todos los demás.
#
# El seed es idempotente: si el admin ya existe NO le pisa la contraseña,
# solo confirma rol=admin y estado=activo. Para rotarla, hazlo desde la app.
ADMIN_EMAIL="tu@correo.com"
ADMIN_PASSWORD=""          # mínimo 12 caracteres; el seed rechaza menos
ADMIN_NOMBRE="Administrador"

# ─── Auth ─── lib/auth/session.ts:15
# Firma los JWT de sesión. Si falta, la app lanza un error explícito al
# primer intento de firmar o verificar: NO arranca con un secreto vacío.
#   openssl rand -base64 32
JWT_SECRET=""

# ─── OpenAI ─── lib/ia/motor.ts:4
OPENAI_API_KEY="sk-..."

# ─── Resend ─── lib/email/resend.ts:14,20
# Resend es un servicio alojado: NO se instala nada en el VPS. Lo que hay que
# configurar son los registros DNS del dominio remitente (DKIM + SPF).
#
# Si esta variable queda VACÍA, lib/email/resend.ts entra en "modo consola":
# no envía nada e imprime el correo —incluido el link de invitación— en el
# log del servidor. Permite desarrollar todo el flujo de invitaciones antes
# de tener el dominio verificado.
RESEND_API_KEY="re_..."

# ─── URL pública de la app ─── lib/email/resend.ts:176,191,205,224
# Se usa para construir los links de los correos (registro, aprobación,
# recordatorio de check-in, aviso al admin). Sin barra final.
APP_URL="https://tudominio.com"


# ═══ OPCIONALES (tienen valor por defecto en el código) ══════════════════════

# Modelo de OpenAI ─── lib/ia/motor.ts:10 — por defecto "gpt-4o"
OPENAI_MODEL="gpt-4o"

# Remitente de los correos ─── lib/email/resend.ts:40
# Debe usar un dominio YA VERIFICADO en Resend, si no la API rechaza el envío
# con 403. Se envía desde el subdominio mail.agotech.cloud —no desde la raíz—
# para aislar la reputación de envío y no tocar el correo que ya recibe el
# dominio.
#
# Formato RFC 5322, con nombre visible entre comillas y dirección entre <>:
#   EMAIL_FROM="Coach Financiero Agotech <coach@mail.agotech.cloud>"
#
# Si pones solo la dirección, el código le antepone NOMBRE_REMITENTE
# (lib/email/resend.ts:28). Sin nombre visible los clientes de correo
# muestran el local-part —"coach"— que no le dice nada al destinatario.
EMAIL_FROM="Coach Financiero Agotech <coach@mail.agotech.cloud>"


# ═══ NO DEFINIR AQUÍ ═════════════════════════════════════════════════════════
#
# NODE_ENV — lo gestiona Next.js según el comando (dev / build / start).
# Fijarlo a mano rompe `next dev` y desactiva el logging de Prisma en
# desarrollo (lib/db/prisma.ts:8) y las cookies inseguras en local
# (lib/auth/session.ts:22).
