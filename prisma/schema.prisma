generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// Moneda de denominación de un monto: la moneda en la que el instrumento
/// realmente existe, no la que el usuario prefiere ver. Un monto se guarda
/// SIEMPRE en su moneda de denominación y nunca se reescribe convertido.
/// En el MVP todos los montos de un usuario comparten su `monedaBase`; la
/// mezcla de monedas requiere tasas de cambio y llega en una actualización
/// posterior. Ver docs/DIRECTRICES_DISENO.md §14.
enum Moneda {
  COP
  USD
}

enum RolUsuario {
  usuario
  admin
}

enum EstadoUsuario {
  pendiente
  activo
  bloqueado
}

enum TipoDeuda {
  tarjeta_credito
  credito_vehiculo
  credito_libre
  credito_hipotecario
  familiar
  otro
}

enum EstadoDeuda {
  activa
  saldada
}

enum CategoriaIngreso {
  salario
  independiente
  negocio
  arriendo
  pension
  otro
}

enum CategoriaEgreso {
  /// Va primero porque la fórmula central de la ETR lo separa del resto:
  /// Ingresos − Egresos (impuestos + supervivencia) = capacidad real.
  impuestos
  arriendo
  servicios
  mercado
  transporte
  salud
  colegiaturas
  otro
}

enum EstadoObjetivo {
  activo
  logrado
  cancelado
}

enum TipoEvento {
  check_in
  deuda_pagada
  deuda_nueva
  ingreso_actualizado
  egreso_actualizado
  objetivo_creado
  objetivo_logrado
  ingreso_extra
  /// Un gasto grande y puntual (RF-047). Valor propio y no `egreso_actualizado`
  /// con un discriminador en el payload porque el historial tendrá que
  /// distinguirlos: aquel cambió la estructura del mes, este fue un golpe de
  /// un día.
  egreso_extra
  plan_generado
}

enum TriggerPlan {
  onboarding
  check_in
  ingreso_extra
}

enum EstadoInvitacion {
  pendiente
  usado
  expirado
}

// ─── Modelos ─────────────────────────────────────────────────────────────────

model Usuario {
  id            String        @id @default(uuid())
  nombre        String
  email         String        @unique
  passwordHash  String        @map("password_hash")
  rol           RolUsuario    @default(usuario)
  estado        EstadoUsuario @default(pendiente)
  ultimoAcceso  DateTime?     @map("ultimo_acceso")
  createdAt     DateTime      @default(now()) @map("created_at")

  /// Moneda en la que el usuario maneja su dinero. En el MVP determina la
  /// denominación de todos sus montos y también cómo se los mostramos.
  monedaBase    Moneda        @default(COP) @map("moneda_base")

  /// Cuándo terminó el onboarding. `null` = todavía no lo ha completado.
  ///
  /// Existe para separar dos cosas que la ETR llama igual: `estado` es
  /// control de ACCESO y lo decide el admin (RF-004, RF-005), mientras que
  /// RF-007 define "activo" como haber completado el onboarding, que es
  /// PROGRESO del usuario. Son conceptos distintos y ahora tienen campos
  /// distintos.
  ///
  /// Se guarda la fecha y no un booleano: `!= null` da el booleano igual, y
  /// además queda el cuándo, que el Motor IA usa como origen de la línea de
  /// tiempo del usuario.
  onboardingCompletadoEn DateTime? @map("onboarding_completado_en")

  /// Cuándo se le mandó el último recordatorio de check-in (RF-028).
  ///
  /// Sin este campo el cron diario mandaría un correo CADA DÍA a partir del
  /// día 15 a quien no haya hecho el check-in, que es la forma más rápida de
  /// que alguien marque la app como spam. Con él se espacia el recordatorio.
  ///
  /// Es estado del sistema, no del usuario, y por eso vive aquí y no en
  /// `eventos`: esa tabla es el historial financiero que la persona ve.
  ultimoRecordatorioEn DateTime? @map("ultimo_recordatorio_en")

  /// Si puede pedir que el Motor IA recalcule su plan cuando quiera (RF-068).
  ///
  /// Lo decide el admin, persona por persona. Es para quien hizo su check-in,
  /// corrigió después sus deudas o ingresos y quiere ver si el consejo cambia
  /// sin esperar al siguiente. Apagado por defecto: cada recálculo es una
  /// llamada al proveedor, y RF-034 fija los disparadores normales.
  puedeRecalcularPlan Boolean @default(false) @map("puede_recalcular_plan")

  objetivos      Objetivo[]
  deudas         Deuda[]
  ingresos       Ingreso[]
  egresos        Egreso[]
  ingresosExtra  IngresoExtra[]
  egresosExtra   EgresoExtra[]
  checkIns       CheckIn[]
  planesIa       PlanIa[]
  eventos        Evento[]
  sesiones       Sesion[]

  @@map("usuarios")
}

/// La mitad con estado de la sesión (RNF-002): el refresh token de 7 días.
///
/// El JWT de acceso dura 24 h y no se guarda en ningún sitio —es stateless y
/// por eso no se puede revocar—. Esta tabla es lo que hace revocable a la
/// sesión completa: al cerrar sesión se marca aquí, y sin refresh vivo el
/// acceso muere como mucho 24 h después.
model Sesion {
  id        String   @id @default(uuid())
  usuarioId String   @map("usuario_id")

  /// SHA-256 del token, nunca el token. Un volcado de la base no da sesiones:
  /// a diferencia de las invitaciones —que sin la aprobación del admin no
  /// abren nada—, este token SÍ es acceso inmediato a la cuenta.
  ///
  /// SHA-256 y no argon2: el token son 32 bytes aleatorios, no una contraseña
  /// que alguien pueda adivinar, y hay que verificarlo en cada rotación.
  tokenHash String   @unique @map("token_hash")

  /// Todas las rotaciones de un mismo inicio de sesión comparten familia. Si
  /// aparece un token ya rotado —señal de que alguien copió la cookie— se
  /// revoca la familia entera, no solo esa fila: el ladrón y la víctima están
  /// en la misma cadena y no hay forma de saber cuál es cuál.
  familia   String

  expiraEn  DateTime @map("expira_en")

  /// Cuándo se canjeó por su sucesor. Con valor, la fila ya no sirve para
  /// autenticar; se conserva porque es lo que permite detectar la reutilización.
  rotadaEn  DateTime? @map("rotada_en")

  /// Cierre de sesión explícito o revocación por reutilización.
  revocadaEn DateTime? @map("revocada_en")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familia])
  @@index([expiraEn])
  @@map("sesiones")
}

model Objetivo {
  id             String         @id @default(uuid())
  usuarioId      String         @map("usuario_id")
  intencion      String
  estado         EstadoObjetivo @default(activo)
  editableDesde  DateTime       @map("editable_desde")
  createdAt      DateTime       @default(now()) @map("created_at")

  /// Cuánto dinero hace falta para lograrla. `null` cuando la intención no se
  /// mide en pesos —"quiero saldar mis deudas", "quiero dejar de vivir al día"—,
  /// que es la mayoría.
  ///
  /// Existe porque sin él las metas de acumulación no tienen forma de medirse:
  /// el avance de una deuda sale de comparar saldo contra saldo original, pero
  /// "la cuota inicial de un apartamento" no deja rastro en ninguna tabla. El
  /// campo es opcional y nunca se deduce del texto: clasificar intenciones
  /// escritas a mano sería adivinar, y adivinar mal aquí pone una barra de
  /// progreso donde no la hay.
  montoObjetivo  Decimal?       @map("monto_objetivo") @db.Decimal(15, 2)

  /// Cuánto lleva apartado para esta meta. Lo reporta la persona en el
  /// check-in, no lo deduce la app: repartir la capacidad real entre las
  /// intenciones daría un avance calculado sobre lo que DEBERÍA haber
  /// apartado, que no es lo que apartó.
  ///
  /// Cero y no null: es una suma, y arrancarla en null obligaría a un
  /// coalesce en cada lectura para llegar al mismo sitio.
  montoAcumulado Decimal        @default(0) @map("monto_acumulado") @db.Decimal(15, 2)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("objetivos")
}

model Deuda {
  id             String      @id @default(uuid())
  usuarioId      String      @map("usuario_id")

  /// Como el usuario reconoce la deuda: "Tarjeta Visa", "Préstamo de mamá".
  ///
  /// No es cosmético. El plan de la IA es prosa accionable —"Abona $850.000 a
  /// la Tarjeta Visa"— y sin nombre solo podría decir "a tu tarjeta de
  /// crédito", que es inservible si hay dos.
  nombre         String

  tipo           TipoDeuda
  montoOriginal  Decimal     @map("monto_original") @db.Decimal(15, 2)
  montoActual    Decimal     @map("monto_actual") @db.Decimal(15, 2)
  moneda         Moneda      @default(COP)
  tasaInteres    Decimal?    @map("tasa_interes") @db.Decimal(5, 2)

  /// Cuota mínima mensual. Opcional: mucha gente no la tiene a la mano, y
  /// exigirla frenaría el onboarding. Cuando existe, acota lo que el plan
  /// puede proponer: por debajo del mínimo la deuda crece.
  pagoMinimo     Decimal?    @map("pago_minimo") @db.Decimal(15, 2)

  estado         EstadoDeuda @default(activa)
  createdAt      DateTime    @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("deudas")
}

model Ingreso {
  id            String           @id @default(uuid())
  usuarioId     String           @map("usuario_id")

  /// Etiqueta del usuario: "Sueldo de Bancolombia". Opcional —la categoría ya
  /// clasifica— pero permite distinguir dos ingresos de la misma categoría.
  descripcion   String?

  categoria     CategoriaIngreso
  montoMensual  Decimal          @map("monto_mensual") @db.Decimal(15, 2)
  moneda        Moneda           @default(COP)
  createdAt     DateTime         @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("ingresos")
}

model Egreso {
  id            String          @id @default(uuid())
  usuarioId     String          @map("usuario_id")

  /// Etiqueta del usuario: "Arriendo del apartamento". Ver Ingreso.descripcion.
  descripcion   String?

  categoria     CategoriaEgreso
  montoMensual  Decimal         @map("monto_mensual") @db.Decimal(15, 2)
  moneda        Moneda          @default(COP)
  createdAt     DateTime        @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("egresos")
}

model IngresoExtra {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  monto       Decimal  @db.Decimal(15, 2)
  moneda      Moneda   @default(COP)
  descripcion String
  fecha       DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("ingresos_extra")
}

/// Un gasto grande que ocurrió una vez y no se repite: la matrícula, la
/// reparación del carro, el impuesto anual del vehículo.
///
/// Es un modelo aparte de `Egreso` y no una fila más con una bandera porque
/// significan cosas distintas. `Egreso` es un compromiso mensual y entra en la
/// capacidad real, que es el margen con el que se proyecta la deuda a años
/// vista; esto ocurrió un día y solo afecta a su mes. Mezclarlos haría que una
/// matrícula empujara el "Faltan N meses" como si se pagara doce veces.
///
/// Sin categoría a propósito (RF-049): la app no es un control de gastos y un
/// selector de categorías es la primera invitación a registrarlo todo.
model EgresoExtra {
  id          String   @id @default(uuid())
  usuarioId   String   @map("usuario_id")
  monto       Decimal  @db.Decimal(15, 2)
  moneda      Moneda   @default(COP)

  /// Obligatoria, igual que en IngresoExtra: un gasto sin nombre no es un
  /// dato, y el Motor IA la lee para escribir su prosa.
  descripcion String

  /// El día en que ocurrió, nunca futuro. Columna DATE: se escribe y se lee en
  /// UTC (`new Date("YYYY-MM-DDT00:00:00Z")` y `formatearFechaUtc`) o en
  /// Colombia el día se corre uno hacia atrás.
  fecha       DateTime @db.Date

  createdAt   DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// La consulta que sostiene la cifra del mes: gastos de un usuario dentro de
  /// un rango de fechas.
  @@index([usuarioId, fecha])
  @@map("egresos_extra")
}

model CheckIn {
  id               String   @id @default(uuid())
  usuarioId        String   @map("usuario_id")
  pagosRealizados  Json     @map("pagos_realizados")
  nuevasDeudas     Json     @map("nuevas_deudas")
  ingresosExtra    Json     @map("ingresos_extra")
  /// El mensaje y el plan que el motor devolvió para este check-in.
  ///
  /// Opcionales porque se escriben DESPUÉS: primero se guarda lo que la
  /// persona reportó —sus pagos, sus deudas nuevas— y solo entonces se llama
  /// al modelo, que tarda medio minuto. Al revés, un fallo del proveedor
  /// borraría lo único que la app no puede reconstruir. Un check-in sin plan
  /// sigue siendo un check-in: cuenta para la fecha del siguiente (RF-033).
  respuestaIa      String?  @map("respuesta_ia")
  planGenerado     Json?    @map("plan_generado")

  /// Foto del estado financiero al cerrar el check-in y el avance de cada
  /// objetivo, que es literalmente lo que pide RF-032.
  ///
  /// Va aquí y no se recalcula al abrirlo porque un check-in es un momento:
  /// releerlo dentro de seis meses con las cifras de entonces es lo que le da
  /// sentido a la línea del historial. Las demás columnas guardan lo que la
  /// persona reportó; esta guarda en qué situación la dejó.
  snapshot         Json

  createdAt        DateTime @default(now()) @map("created_at")

  /// Tasa (COP por 1 unidad de moneda extranjera) con la que se calculó este
  /// snapshot. Congelarla evita que un check-in pasado muestre cifras
  /// distintas cada vez que se abre. Null mientras no haya conversión.
  tasaCopUsada     Decimal? @map("tasa_cop_usada") @db.Decimal(15, 6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

model PlanIa {
  id          String      @id @default(uuid())
  usuarioId   String      @map("usuario_id")
  contenido   Json
  trigger     TriggerPlan
  createdAt   DateTime    @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("planes_ia")
}

model Evento {
  id           String     @id @default(uuid())
  usuarioId    String     @map("usuario_id")
  tipo         TipoEvento
  payload      Json
  progresoPct  Decimal?   @map("progreso_pct") @db.Decimal(5, 2)
  createdAt    DateTime   @default(now()) @map("created_at")

  /// Tasa congelada en el momento del evento. Ver CheckIn.tasaCopUsada.
  tasaCopUsada Decimal?   @map("tasa_cop_usada") @db.Decimal(15, 6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("eventos")
}

/// Tasas de cambio diarias. SIN USO EN EL MVP — se puebla cuando se integre la
/// fuente de tasas (para COP, la TRM de la Superfinanciera). Una fila por
/// moneda y día; `valorCop` es cuántos COP vale 1 unidad de `moneda`.
model TasaCambio {
  id        String   @id @default(uuid())
  moneda    Moneda
  fecha     DateTime @db.Date
  valorCop  Decimal  @map("valor_cop") @db.Decimal(15, 6)
  fuente    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([moneda, fecha])
  @@map("tasas_cambio")
}

model Invitacion {
  id           String           @id @default(uuid())
  emailDestino String           @map("email_destino")
  token        String           @unique
  estado       EstadoInvitacion @default(pendiente)
  expiresAt    DateTime         @map("expires_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("invitaciones")
}
