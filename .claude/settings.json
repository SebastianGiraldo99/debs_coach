{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Write(./.env.local)",
      "Read(./.env.development)",
      "Edit(./.env.development)",
      "Write(./.env.development)",
      "Read(./.env.production)",
      "Edit(./.env.production)",
      "Write(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env.test)",
      "Write(./.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-env.sh\"",
            "statusMessage": "Verificando acceso a .env"
          }
        ]
      }
    ]
  }
}
